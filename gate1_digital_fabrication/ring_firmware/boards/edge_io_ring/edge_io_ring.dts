/dts-v1/;
/ {
  model = "gunnchOS Edge I/O Ring EVT0";
  compatible = "gunnchos,edge-io-ring";
  chosen {
    zephyr,sram = &sram0;
    zephyr,flash = &flash0;
    zephyr,console = &uart0;
  };
  /*
   * Continuation V parity stubs vs hardware BOM/schematic.
   * PHYSICAL_EXECUTION_FREEZE — digital only; physical pin verify pending.
   * See dts/pinout.json and docs/BOM_SCH_FW_PARITY_CONTINUATION_V.md
   */
  aliases {
    imu-int = &imu_int;
    chg-status = &chg_status;
    imu-i2c = &i2c0;
    cap-int = &cap_int;
    se-irq = &se_irq;
  };
  gpio_inputs {
    compatible = "gpio-keys";
    imu_int: imu_int {
      gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
      label = "IMU_INT";
    };
    chg_status: chg_status {
      gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
      label = "CHG_STATUS";
    };
    cap_int: cap_int {
      gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
      label = "CAP_INT_IQS7222A_STUB";
    };
    se_irq: se_irq {
      gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
      label = "SE_IRQ_SE050_STUB";
    };
  };
};
&gpio0 { status = "okay"; };
&i2c0 {
  status = "okay";
  /* SDA P0.26 SCL P0.27 — parity with hardware EVT0 assumption */
  clock-frequency = <400000>;
  /* Device nodes below are documentation stubs until drivers land */
};
&uart0 { status = "okay"; };
&usbd { status = "okay"; };
