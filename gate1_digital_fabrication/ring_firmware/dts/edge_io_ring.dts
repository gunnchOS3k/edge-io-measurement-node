/dts-v1/;

/*
 * Device tree source (Zephyr-shaped) for Edge I/O Ring EVT0.
 * Continuation V: parity stubs for IQS7222A / SE050 GPIOs vs hardware BOM.
 * PHYSICAL_EXECUTION_FREEZE — digital only; not a physical boot claim.
 */

/ {
	model = "gunnchos Edge I/O Ring EVT0";
	compatible = "gunnchos,edge-io-ring";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,console = &uart0;
	};

	aliases {
		imu-int = &imu_int;
		chg-status = &chg_status;
		imu-i2c = &i2c0;
		cap-int = &cap_int;
		se-irq = &se_irq;
	};

	gpio_inputs {
		compatible = "gpio-keys";

		imu_int: imu_int {
			gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;
			label = "IMU_INT";
		};

		chg_status: chg_status {
			gpios = <&gpio0 2 GPIO_ACTIVE_LOW>;
			label = "CHG_STATUS";
		};

		cap_int: cap_int {
			gpios = <&gpio0 15 GPIO_ACTIVE_LOW>;
			label = "CAP_INT_IQS7222A_STUB";
		};

		se_irq: se_irq {
			gpios = <&gpio0 16 GPIO_ACTIVE_LOW>;
			label = "SE_IRQ_SE050_STUB";
		};
	};
};

&gpio0 { status = "okay"; };

&i2c0 {
	status = "okay";
	clock-frequency = <400000>;
	/* SDA P0.26 SCL P0.27 — see dts/pinout.json */
};

&uart0 { status = "okay"; };

&usbd { status = "okay"; };
